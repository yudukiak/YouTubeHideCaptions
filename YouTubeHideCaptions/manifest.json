{
  "name": "YouTubeHideCaptions",
  "description": "YouTubeの字幕表示をワンクリックで切り替えられるよ。",
  "author": "akasaka",
  "version": "0.0.0",
  "manifest_version": 3,
  "icons": {
    "16": "icons/16.png",
    "64": "icons/64.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/*"],
      "js": ["src/title-slot.js", "src/script.js"],
      "css": ["src/styles.css"],
      "run_at": "document_end"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "youtubehidecaptions@ydk.vc",
      "strict_min_version": "121.0"
    }
  }
}
